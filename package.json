{
  "name": "frostpom",
  "version": "4.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:visual": "python tests/visual.py",
    "test:visual:update": "python tests/visual.py --update",
    "android:www": "node tools/app-www.mjs",
    "android:crear": "npm run android:www && npx cap add android && node tools/app-android.mjs && npx cap sync android && node tools/revisar-android.mjs",
    "android:actualizar": "npm run android:www && node tools/app-android.mjs && npx cap sync android && node tools/revisar-android.mjs",
    "android:abrir": "npx cap open android",
    "edge:pegar": "node tools/edge-pegar.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.4.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@frostpom/timer": "file:native/frostpom-timer",
    "@revenuecat/purchases-capacitor": "14.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
