<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- La hora de los widgets. Los widgets no cargan las letras de la app (Lilita One): se usa la
         más gruesa del teléfono, como en el diseño. -->
    <style name="FpTime">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- "MODO ENFOQUE" -->
    <style name="FpMode">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 00:00 · 25:00 debajo de la barra -->
    <style name="FpSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#C7FFFFFF</item>
        <item name="android:textSize">8.5sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
