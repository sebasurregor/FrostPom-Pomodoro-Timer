<?xml version="1.0" encoding="utf-8"?>
<!--
  FrostPom (v4.9.1) — copias de seguridad en Android 11 o más viejo (tools/app-android.mjs).
  Igual que data_extraction_rules.xml: solo se copia al pasar al celular nuevo, no a la nube.
  (requireFlags existe desde Android 9; en Android 7 y 8 esta marca no se entiende y la copia en la
  nube sigue como antes.)
-->
<full-backup-content>
    <include domain="root" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="sharedpref" path="." requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
